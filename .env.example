# =============================================================================
# SUPER CODER CLOUD — environment reference (ALL variables)
# Copy the ones you need into apps/web/.env.local (local) or Vercel (prod).
# Full documentation: docs/ENVIRONMENT.md
# NEVER put a secret in a NEXT_PUBLIC_ variable — those ship to every browser.
# =============================================================================

# ---- Required (public, safe for the browser) --------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show the "Continue with Google" button (configure the provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---- Server-only secrets -----------------------------------------------------
# Bypasses RLS. Server code only. Required in production.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the worker and migration tooling.
DATABASE_URL=
# 32-byte hex key for AES-256-GCM encryption of integration credentials:  openssl rand -hex 32
ENCRYPTION_KEY=
# Shared secret that cron/scheduler requests must present (Phase 3).
CRON_SECRET=
# true → workspace-wide demo behaviour (no outbound messages, payments or AI calls)
DEMO_MODE=false

# ---- Optional integrations (missing → integration disabled gracefully) ------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini — free tier: aistudio.google.com → Get API key
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
SMS_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
QUEUE_PROVIDER_URL=
QUEUE_PROVIDER_TOKEN=

# ---- Worker ------------------------------------------------------------------
WORKER_INTERVAL_MS=3600000
WORKER_ONCE=false

# ---- Testing -----------------------------------------------------------------
# Postgres URL with CREATE DATABASE rights (Supabase CLI local default shown)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
E2E_BASE_URL=http://localhost:3000

# ---- v2: commercial layer (billing, AI, keep-alive) -------------------------
# Stripe price ids per plan/interval (Stripe Dashboard → Products → price id "price_...")
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
# Optional: shown on the Enterprise card ("Talk to us")
NEXT_PUBLIC_SALES_EMAIL=
# Optional model / endpoint overrides (defaults: claude-haiku-5-5, gpt-4o-mini, official endpoints)
AI_ANTHROPIC_MODEL=
AI_OPENAI_MODEL=
AI_ANTHROPIC_BASE_URL=
AI_OPENAI_BASE_URL=
PAYMENT_PROVIDER_API_BASE=
# GitHub-only secrets (Actions): VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
# SUPABASE_DB_URL, BACKUP_PASSPHRASE, APP_URL, CRON_SECRET

# ---- v3: activation & speed --------------------------------------------------
# Easiest: run setup.cmd (Windows) / node scripts/setup/configure.mjs — it asks
# for the keys, generates CRON_SECRET/ENCRYPTION_KEY and writes them to Vercel +
# GitHub for you. Values are never written into the repository.
# Email (Resend): with EMAIL_PROVIDER_API_KEY + EMAIL_FROM_ADDRESS set, team
# invitations are emailed automatically. Optional endpoint override (tests/proxy):
EMAIL_PROVIDER_API_BASE=
# CRON_SECRET (above) + SUPABASE_SERVICE_ROLE_KEY → the daily Vercel Cron call to
# /api/keepalive also runs public.run_maintenance() (no separate worker host needed).

# ---- v6: the AI agent answers customers on every channel ---------------------
# Website chat needs nothing extra (works on every site built here + /widget.js).
# WhatsApp official one-click connect (Meta Embedded Signup) — see docs/CONNECT_CHANNELS_HE.md
META_APP_ID=
META_APP_SECRET=
META_WA_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=
# WhatsApp by QR code — the always-on bridge service (services/wa-bridge, e.g. on Railway)
WA_BRIDGE_URL=
WA_BRIDGE_SECRET=
# E-mail: "Sign in with Google / Microsoft" (any other mailbox works with an app password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Language of a first visit: Hebrew (default). Set to "browser" to follow the browser language.
NEXT_PUBLIC_LOCALE_NEGOTIATION=
