# =============================================================================
# SUPER CODER CLOUD — environment reference (ALL variables)
# Copy the ones you need into apps/web/.env.local (local) or Vercel (prod).
# Full documentation: docs/ENVIRONMENT.md
# NEVER put a secret in a NEXT_PUBLIC_ variable — those ship to every browser.
# =============================================================================

# ---- Required (public, safe for the browser) --------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show the "Continue with Google" button (configure the provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---- Server-only secrets -----------------------------------------------------
# Bypasses RLS. Server code only. Required in production.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the worker and migration tooling.
DATABASE_URL=
# 32-byte hex key for AES-256-GCM encryption of integration credentials:  openssl rand -hex 32
ENCRYPTION_KEY=
# Shared secret that cron/scheduler requests must present (Phase 3).
CRON_SECRET=
# true → workspace-wide demo behaviour (no outbound messages, payments or AI calls)
DEMO_MODE=false

# ---- Optional integrations (missing → integration disabled gracefully) ------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini — free tier: aistudio.google.com → Get API key
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
SMS_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
QUEUE_PROVIDER_URL=
QUEUE_PROVIDER_TOKEN=

# ---- Worker ------------------------------------------------------------------
WORKER_INTERVAL_MS=3600000
WORKER_ONCE=false

# ---- Testing -----------------------------------------------------------------
# Postgres URL with CREATE DATABASE rights (Supabase CLI local default shown)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
E2E_BASE_URL=http://localhost:3000

# ---- v2: commercial layer (billing, AI, keep-alive) -------------------------
# Stripe price ids per plan/interval (Stripe Dashboard → Products → price id "price_...")
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
# Optional: shown on the Enterprise card ("Talk to us")
NEXT_PUBLIC_SALES_EMAIL=
# Optional model / endpoint overrides (defaults: claude-haiku-5-5, gpt-4o-mini, official endpoints)
AI_ANTHROPIC_MODEL=
AI_OPENAI_MODEL=
AI_ANTHROPIC_BASE_URL=
AI_OPENAI_BASE_URL=
PAYMENT_PROVIDER_API_BASE=
# GitHub-only secrets (Actions): VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
# SUPABASE_DB_URL, BACKUP_PASSPHRASE, APP_URL, CRON_SECRET

# ---- v3: activation & speed --------------------------------------------------
# Easiest: run setup.cmd (Windows) / node scripts/setup/configure.mjs — it asks
# for the keys, generates CRON_SECRET/ENCRYPTION_KEY and writes them to Vercel +
# GitHub for you. Values are never written into the repository.
# Email (Resend): with EMAIL_PROVIDER_API_KEY + EMAIL_FROM_ADDRESS set, team
# invitations are emailed automatically. Optional endpoint override (tests/proxy):
EMAIL_PROVIDER_API_BASE=
# CRON_SECRET (above) + SUPABASE_SERVICE_ROLE_KEY → the daily Vercel Cron call to
# /api/keepalive also runs public.run_maintenance() (no separate worker host needed).

# ---- v6: the AI agent answers customers on every channel ---------------------
# Website chat needs nothing extra (works on every site built here + /widget.js).
# WhatsApp official one-click connect (Meta Embedded Signup) — see docs/CONNECT_CHANNELS_HE.md
META_APP_ID=
META_APP_SECRET=
META_WA_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=
# WhatsApp by QR code — the always-on bridge service (services/wa-bridge, e.g. on Railway)
WA_BRIDGE_URL=
WA_BRIDGE_SECRET=
# E-mail: "Sign in with Google / Microsoft" (any other mailbox works with an app password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Language of a first visit: Hebrew (default). Set to "browser" to follow the browser language.
NEXT_PUBLIC_LOCALE_NEGOTIATION=

# ---- v8: more ways to pay for a plan (all optional, next to Stripe) -------------
# PayPal — the customer pays with PayPal or a card (guest checkout, where PayPal offers it); money lands in your PayPal.
# developer.paypal.com → Apps & Credentials → (Live) app. Webhook: https://<your-domain>/api/webhooks/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live (default) or sandbox
PAYPAL_MODE=
PAYPAL_WEBHOOK_ID=
# Lemon Squeezy — card / Apple Pay / Google Pay / PayPal as merchant of record (handles VAT), payouts to PayPal or bank.
# Webhook: https://<your-domain>/api/webhooks/lemonsqueezy  (events: subscription_*, order_created)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTH=
LEMONSQUEEZY_VARIANT_PRO_YEAR=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTH=
LEMONSQUEEZY_VARIANT_BUSINESS_YEAR=
# Crypto (NOWPayments) — money to your own crypto wallet. IPN: https://<your-domain>/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Shown on every receipt
BILLING_BUSINESS_NAME=
BILLING_BUSINESS_ID=
BILLING_BUSINESS_ADDRESS=
BILLING_BUSINESS_EMAIL=
# Telegram personal account (on the bridge service, not Vercel): TELEGRAM_API_ID / TELEGRAM_API_HASH from my.telegram.org
# Optional tuning: how long an automatic reply waits for a busy AI provider (ms, default 45000)
AI_AUTOPILOT_PATIENCE_MS=

# ---- v9: AI router — add free keys from several providers (the agent fails over instantly) ----
# Groq: console.groq.com → API Keys   ·   Cerebras: cloud.cerebras.ai   ·   OpenRouter: openrouter.ai/keys   ·   Mistral: console.mistral.ai
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Optional: provider order (default groq,cerebras,gemini,openrouter,mistral,anthropic,openai)
AI_PROVIDER_ORDER=
# ---- wave 55: five more FREE engines join the failover chain (each is used only when its key is set) ----
# Cloudflare Workers AI (text) uses the same CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_AI_TOKEN as the image engine (nothing new to add)
# GitHub Models: github.com/settings/tokens (fine-grained token with "Models: read")
GITHUB_MODELS_TOKEN=
# SambaNova: cloud.sambanova.ai → API Keys   ·   NVIDIA NIM: build.nvidia.com → Get API Key   ·   Hugging Face: huggingface.co/settings/tokens
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
# Optional model lists / endpoints per engine (comma-separated)
# AI_CLOUDFLARE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/openai/gpt-oss-120b
# AI_CLOUDFLARE_BASE_URL=
# AI_GITHUB_MODELS=openai/gpt-4.1-mini,openai/gpt-4o-mini
# AI_GITHUB_BASE_URL=
# AI_SAMBANOVA_MODELS=Meta-Llama-3.3-70B-Instruct
# AI_SAMBANOVA_BASE_URL=
# AI_NVIDIA_MODELS=meta/llama-3.3-70b-instruct
# AI_NVIDIA_BASE_URL=
# AI_HUGGINGFACE_MODELS=openai/gpt-oss-120b
# AI_HUGGINGFACE_BASE_URL=
# ---- wave 56: phone calls at a human level ----
# Live calls (continuous audio + interruptions) run automatically when the bridge (WA_BRIDGE_URL) runs the
# wave-56 version and ElevenLabs or OpenAI is set. "off" = always turn by turn, "on" = skip the health check.
VOICE_REALTIME=
# "basic" = the original simple phone brain (default: the full sales brain)
VOICE_BRAIN=
# "off" = the standard Twilio voice instead of the agent's own voice on turn-by-turn calls
VOICE_PHONE_TTS=
# ElevenLabs model for phone calls (default: eleven_v3 for Hebrew, eleven_flash_v2_5 for English/Arabic)
ELEVENLABS_PHONE_MODEL=
# ---- wave 57: phone numbers for every business from ONE platform Twilio account (businesses never touch Twilio) ----
TWILIO_PLATFORM_ACCOUNT_SID=
TWILIO_PLATFORM_AUTH_TOKEN=
# country for automatic numbers (US, GB, IL …); Israeli numbers need Twilio approval → buy in Twilio, assign in the admin console
TWILIO_PLATFORM_COUNTRY=
# monthly call minutes per business on platform numbers (default 300, 0 = unlimited)
VOICE_PLATFORM_MINUTES=

# =====================================================================================================
# ---- Complete reference of optional variables read by the code (all commented: uncomment to use) ----
# =====================================================================================================
# Public app
# APP_URL=https://app.example.com                  # wa-bridge / worker callbacks to the web app
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Jerusalem          # timezone used to render dates (default: Asia/Jerusalem)
# SITES_ROOT_DOMAIN=sites.example.com              # wildcard domain for published customer sites
# SITES_DEFAULT_LANG=he
# Push notifications (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Shopify
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=
# Vercel domains API (custom domains for customer sites)
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# DOMAIN_AUTO_RENEW=
# Meta (Messenger / Instagram) extras
# META_PAGES_CONFIG_ID=
# META_PAGES_APP_SECRET=
# META_IG_APP_SECRET=
# META_WEBHOOK_AUTOFIX=
# Telegram personal account + WhatsApp bridge (services/wa-bridge)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# DATA_DIR=/data                                   # persistent volume for WhatsApp sessions
# LOG_LEVEL=info
# Backups (GitHub Actions secret used by db-backup.yml to encrypt dumps)
# BACKUP_PASSPHRASE=
# PayPal for organisations / misc
# PAYPAL_SHOW_SUBSCRIPTION=
# PAYPAL_SDK_URL=
# AI router tuning
# AI_ROUTER_PER_PROVIDER=
# AI_GEMINI_MODEL=
# AI_GEMINI_FALLBACK_MODELS=
# AI_GEMINI_IMAGE_MODELS=
# Provider API base overrides (testing / proxies only — leave unset in production)
# AI_GEMINI_BASE_URL= AI_GROQ_BASE_URL= GA4_MP_BASE= TIKTOK_API_BASE= GBP_ACCOUNTS_API_BASE= GBP_INFO_API_BASE= GBP_V4_API_BASE=
# GOOGLE_CALENDAR_API_BASE= GOOGLE_OAUTH_AUTHORIZE_URL= GOOGLE_OAUTH_TOKEN_URL= MICROSOFT_OAUTH_AUTHORIZE_URL= MICROSOFT_OAUTH_TOKEN_URL=
# MS_GRAPH_API_BASE= META_GRAPH_BASE= ICOUNT_API_BASE= MORNING_API_BASE= ORG_PAYPAL_API_BASE= PAYPAL_API_BASE= SHOPIFY_API_BASE=
# VERCEL_API_BASE= LEMONSQUEEZY_API_BASE= NOWPAYMENTS_API_BASE= TELEGRAM_API_BASE= WHATSAPP_API_BASE= TWILIO_API_BASE= PUSH_TEST_ENDPOINT_BASE=
# Post studio image fallback (used when the Gemini image quota is exhausted; all optional)
# STUDIO_IMAGE_FALLBACK=
# STUDIO_IMAGE_FALLBACK_URL=
# POLLINATIONS_API_KEY=
# Wave 49 — free image providers for the post studio (all optional; several keys/accounts allowed, comma-separated)
#   Cloudflare Workers AI (free daily quota): dash.cloudflare.com → AI → Workers AI → "Use REST API"
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_AI_ACCOUNTS=accountId:token,accountId2:token2
#   Hugging Face (free monthly credits): huggingface.co/settings/tokens → "Make calls to Inference Providers"
# HF_TOKEN=
# HF_TOKENS=
#   Together AI (FLUX.1-schnell-Free): api.together.ai
# TOGETHER_API_KEY=
#   Free stock photos: pexels.com/api · pixabay.com/api/docs
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
#   Openverse (keyless, CC0 only) and the branded design are on by default; "off" disables them
# STUDIO_OPENVERSE=
# STUDIO_BRAND_ART=
#   Custom order, e.g. cloudflare,huggingface,pollinations,pexels,brand
# STUDIO_IMAGE_CHAIN=
#   Optional model overrides for the free providers (defaults: FLUX.1-schnell)
# CLOUDFLARE_IMAGE_MODEL=
# HF_IMAGE_MODEL=
# TOGETHER_IMAGE_MODEL=
