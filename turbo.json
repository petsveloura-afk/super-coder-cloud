{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "DEMO_MODE"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": {
      "passThroughEnv": ["DATABASE_ADMIN_URL"],
      "cache": false
    },
    "dev": { "cache": false, "persistent": true }
  }
}
